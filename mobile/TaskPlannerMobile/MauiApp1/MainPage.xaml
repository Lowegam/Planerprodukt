<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskPlannerMobile.MainPage"
             Title="Planer Produktywności">
    <Grid Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackLayout Orientation="Horizontal" Margin="0,0,0,10">
            <Entry x:Name="TxtTitle" Placeholder="Tytuł zadania" WidthRequest="200"/>
            <Button Text="Dodaj" Clicked="BtnAdd_Clicked" WidthRequest="80"/>
            <Button Text="Odśwież" Clicked="BtnRefresh_Clicked" WidthRequest="80"/>
        </StackLayout>

        <Label x:Name="LblInfo" Grid.Row="1" Margin="0,5" FontSize="12"/>
        <CollectionView x:Name="CvTasks" Grid.Row="2">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Usuń" BackgroundColor="Red" Invoked="SwipeDelete_Invoked"/>
                                <SwipeItem Text="Wykonane" BackgroundColor="Green" Invoked="SwipeDone_Invoked"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Frame Margin="0,5" Padding="10" BorderColor="Gray" CornerRadius="5">
                            <StackLayout>
                                <Label Text="{Binding title}" FontSize="16" FontAttributes="Bold"/>
                                <Label Text="{Binding status}" FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding priority}" FontSize="12" TextColor="Gray"/>
                            </StackLayout>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>