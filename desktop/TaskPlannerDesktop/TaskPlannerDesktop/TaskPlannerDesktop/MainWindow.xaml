<Window x:Class="TaskPlannerDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Planer" Height="500" Width="800" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="+ Dodaj" Width="80" Margin="5" Click="BtnAdd_Click"/>
            <Button Content="Usuń" Width="80" Margin="5" Click="BtnDelete_Click"/>
            <Button Content="Odśwież" Width="80" Margin="5" Click="BtnRefresh_Click"/>
            <Button Content="Eksportuj CSV" Width="120" Margin="5" Click="BtnExport_Click"/>
        </StackPanel>
        <DataGrid x:Name="DgTasks" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Window>